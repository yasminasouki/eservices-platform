APP_NAME=EServices
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eservices_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null for local dev. Must match the host you use in the browser (do not set to "localhost" if you open http://127.0.0.1 — that creates a second cookie and odd behavior).
SESSION_DOMAIN=null
# Optional. If unset, "secure" cookies follow APP_URL (http = off, https = on). Set false if you use HTTPS but APP_URL is still http://localhost.
# SESSION_SECURE_COOKIE=false

# Use `reverb` for real-time chat (run `php artisan reverb:start` in another terminal).
# Generate app credentials with `php artisan reverb:install` or set manually to match `config/reverb.php`.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=100001
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="your@gmail.com"
MAIL_FROM_NAME="E-Services Platform"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OCR.space API — required for Lebanese ID extraction (free key: https://ocr.space/ocrapi )
OCR_SPACE_API_KEY=
# Optional: if DNS to api.ocr.space is slow, raise connect timeout (seconds)
# OCR_SPACE_CONNECT_TIMEOUT=30
# Optional: override endpoint (default https://api.ocr.space/parse/image)
# OCR_SPACE_URL=https://api.ocr.space/parse/image
# Optional: if engine 1 returns fewer chars than this, retry once with engine 2 (0 = disable fallback)
# OCR_SPACE_FALLBACK_MIN_CHARS=50

# ── Payments (citizen checkout) ───────────────────────────────────────────────
# Stripe — embedded card fields (PaymentIntent + Elements). Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cryptocurrency receiving addresses (shown after live CoinGecko USD→crypto quote).
# On APP_ENV=local, demo placeholders are used when these are empty (see config/payments.php).
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDT_ERC20_ADDRESS=
# Set false on local if you want to require real addresses in .env (otherwise demo wallets fill empty slots).
# CRYPTO_USE_DEMO_ADDRESSES=true
# If true, clicking "I have sent the payment" completes the request immediately (local/demo only).
# PAYMENTS_CRYPTO_AUTO_COMPLETE=true
# Quote TTL (minutes). After this, citizen must click "Get quote" again before confirming.
# PAYMENTS_CRYPTO_QUOTE_VALID_MINUTES=45
# When PAYMENTS_CRYPTO_AUTO_COMPLETE=false, require a tx hash / explorer link before "I have sent" (recommended).
# PAYMENTS_CRYPTO_REQUIRE_TX_REFERENCE=true
# Minimum length for tx reference when required (after normalizing explorer URLs).
# PAYMENTS_CRYPTO_TX_REF_MIN_LENGTH=10

# Optional overrides for exchange APIs (defaults: Frankfurter ECB + CoinGecko public)
# EXCHANGE_FRANKFURTER_URL=https://api.frankfurter.app/latest
# EXCHANGE_COINGECKO_URL=https://api.coingecko.com/api/v3
# EXCHANGE_CACHE_TTL=120
# EXCHANGE_HTTP_TIMEOUT=12

# Maps (Leaflet + OpenStreetMap — no Google API key). See config/maps.php.
# MAP_DEFAULT_LAT=33.8938
# MAP_DEFAULT_LNG=35.5018
# MAP_MAX_ZOOM=18
# OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
